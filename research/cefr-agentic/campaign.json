      "adapter_manifest",
      "simulated_episode_transcripts",
      "blind_judgments",
      "controls",
      "paired_comparisons",
      "report"
    ],
    "state_in_report_that_results_are_unmeasured_until_executed": true
  },
  "revisions_applied": {
    "plan": "autopilot-cefr-weightspace-plan v2 (approved 2026-11-03)",
    "R1": "final-site overlay applied exactly in logit space: logits += gate*alpha*dot(a,h_final)*(W_head b); final_input is post-norm SRQ data feeding an integer head",
    "R2": "added residual_after_mlp site at one layer chosen on dev from {20,22,24}",
    "R3": "self-gated variant gate=clamp(p.h_meta,-1,1) with p the dev-fit requested-level probe; external gate kept as baseline",
    "R4": "hook layers {12,20,22,24,final}",
    "R5": "primary outcome cefr_control; joint pass and hard gates are non-inferiority guardrails",
    "R6": "judge budget 300 dev + 120 sealed agent judge calls; a call scores a batch of blinded episodes for one judge role",
    "R7": "sealed set authored by a separate agent outside the repository; only its hash is recorded",
    "R8": "each scenario family instantiated at A1 and B2 with identical world state",
    "R9": "weights loaded from a local hash-checked file via the dev server"
  }
}
