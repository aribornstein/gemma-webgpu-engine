{
 "role": "weight_space_investigator (representation analyst)",
 "task": "Propose at most 4 candidate rank-1 effective-weight edits to make metadata-only (canonical prompt) Hebrew NPC dialogue follow the requested CEFR level (A1 simpler, B2 richer) without hurting grammar, naturalness or world-state fidelity.",
 "operator": {
  "residualL": "after layer L: h <- h + coefficient * b * dot(a, h); next-layer input re-derived; equivalent to W_eff = W + coefficient * b a^T on the layer's residual write",
  "final": "logits += coefficient * dot(a, h_final) * (W_head b); equivalent to W_head_eff = W_head + coefficient * (W_head b) a^T",
  "a": "unit mean state direction at the site (dot(a,h) ~ mean_state_norm, so shift magnitude ~ |coefficient| * mean_state_norm)",
  "b_simplify": "unit direction A1-style minus B2-style reference replies (development families only)",
  "gates": {
   "external": "coefficient = +alpha for requested A1, -alpha for B2 (parsed from metadata by code)",
   "self": "coefficient = alpha * clamp((p.h_meta - t)/s, -1, 1), p = A1-minus-B2 direction of the model's own end-of-metadata state at the site (fit on dev), t,s from dev class means; available where self_gate_train_separation is true"
  },
  "alpha_units": "alpha is the fraction of the mean state norm moved along b (e.g. 0.05 moves ~5% of the state norm)"
 },
